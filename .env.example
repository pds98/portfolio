# Copiez ce fichier :  cp .env.example .env
# Le fichier .env n'est JAMAIS versionné (voir .gitignore).

# --- PostgreSQL ---
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-moi-en-local

# --- API ---
PORT=3000
NODE_ENV=development
# Origine autorisée par CORS (adresse du frontend)
CORS_ORIGIN=http://localhost:5173
# Durées en secondes
SESSION_TTL_SECONDS=604800
PUBLIC_CACHE_TTL_SECONDS=300
CV_CACHE_TTL_SECONDS=86400
# Échecs de connexion tolérés par IP et par 15 min (anti force brute)
AUTH_RATE_LIMIT_MAX=10
# Coût bcrypt (12 recommandé ; 4 suffit pour accélérer les tests)
BCRYPT_ROUNDS=12

# --- Frontend ---
VITE_API_URL=http://localhost:3000
